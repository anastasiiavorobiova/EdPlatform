# Скопіюйте у .env і заповніть: cp .env.example .env
# Застосунок і docker compose не стартують, якщо обов'язкової змінної немає або вона некоректна.

# Необов'язкові: development | production | test (за замовчуванням development) і порт API (за замовчуванням 3000)
NODE_ENV=development
PORT=3000

# PostgreSQL (обов'язкові)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=edplatform

# Адреса Postgres для запуску без Docker (обов'язкові).
# У контейнері compose задає DB_HOST=db і DB_PORT=5432 сам.
DB_HOST=localhost
DB_PORT=5435

# Логування SQL-запитів TypeORM: true | false (за замовчуванням false).
# Зручно вмикати в dev, щоб бачити N+1 та інші зайві запити.
DB_LOGGING=false

# Лише dev: порт Postgres на хості (docker-compose.override.yml)
DB_PUBLISHED_PORT=5435
